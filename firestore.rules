rules_version = '2';

// Rankly Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users/{uid} -------------------------------------------------
    // A user may read/update ONLY their own profile. Creation happens
    // server-side (Admin SDK) after token verification; clients may update
    // only safe profile fields.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['nickname', 'displayName', 'photoURL', 'updatedAt']);
      allow create, delete: if false; // server-managed
    }

    // ---- audits/{auditId} --------------------------------------------
    // Created exclusively by the server (Admin SDK) after analysis.
    // Clients can read public reports, or their own private reports.
    // No client writes — scores, ownership, cooldowns are server-generated.
    match /audits/{auditId} {
      allow get, list: if request.auth != null
                       && resource.data.visibility == 'private'
                       ? resource.data.userId == request.auth.uid
                       : (resource.data.visibility == 'public'
                          && !(resource.data.expiresAt != null
                               && resource.data.expiresAt.toMillis() < request.time.toMillis()));
      allow create, update, delete: if false; // server-only via Admin SDK
    }

    // ---- domains/{hostname} -------------------------------------------
    // 7-day cooldown source of truth. Server-managed; public read for UX.
    match /domains/{hostname} {
      allow read: if true;
      allow write: if false; // server-only
    }

    // ---- guests/{guestId} ---------------------------------------------
    // Guest free-analysis consumption. Signed cookie identity; fully
    // server-managed — clients cannot read or write.
    match /guests/{guestId} {
      allow read, write: if false; // server-only via Admin SDK
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
